# Desktop Service App settings.
# Milliseconds to wait for a service app to accept a connection.
connect.timeout.ms=10000
# Milliseconds to wait for a service app to answer one request.
read.timeout.ms=30000
# Milliseconds between task status checks while a service app runs.
poll.interval.ms=500
# Milliseconds a whole service app run may take before it is stopped.
run.timeout.ms=1800000
